{
  "name": "stecknadel",
  "productName": "Stecknadel",
  "version": "0.0.0",
  "private": true,
  "description": "Geotag your photos from your Dawarich location history",
  "main": "./out/main/index.js",
  "author": "LekoArts <lekoarts@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/LekoArts/stecknadel",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LekoArts/stecknadel.git"
  },
  "packageManager": "pnpm@11.28.3",
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "test": "vitest run",
    "test:e2e": "playwright test --project=packaged-dir",
    "test:native": "vitest run src/main/exiftool.test.ts src/main/library/read.test.ts src/main/thumbs.test.ts src/main/ipc-auth.test.ts src/main/preview.test.ts src/main/track/bridge.test.ts src/main/track/zones.test.ts",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:mac": "electron-builder --mac dmg --arm64 --publish never",
    "package:mac:dir": "electron-builder --mac --dir",
    "package:win": "electron-builder --win nsis portable --x64 --publish never",
    "fixtures": "node scripts/fetch-fixtures.mjs",
    "make-fixtures": "node scripts/make-fixtures.mjs",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "make-pmtiles": "node scripts/make-pmtiles.mjs",
    "check:design": "node scripts/check-design.mjs"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "exiftool-vendored": "39.4.0",
    "fast-xml-parser": "^5.12.1",
    "temporal-polyfill": "1.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-virtual": "^3.14.28",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "electron": "44.11.6",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "lucide-react": "^1.81.0",
    "maplibre-gl": "^6.19.0",
    "pmtiles": "^4.5.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  }
}
